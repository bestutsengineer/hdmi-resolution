[Unit]
Description=Display rules: mirror-mode panel resolution and extend-mode placement
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/hdmi-resolution
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes

[Install]
WantedBy=graphical-session.target
